# ===== tool_governance_demo.py 读取的环境变量模板 =====
# 复制为 .env 后填入真实值：cp .env.example .env
# .env 不入库，模板入库，方便协作时知道需要哪些变量。

# [必需，仅 --agent 模式] DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# [可选] OpenAI 兼容接口地址，缺省即 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# [可选] 模型名，缺省即 deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash
